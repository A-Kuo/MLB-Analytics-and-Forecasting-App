__pycache__/
*.pyc
.venv/
venv/
.env
.ipynb_checkpoints/
# Only the secrets file -- a .streamlit/config.toml (theming) should be committed.
# .streamlit/secrets.toml

# Generator/validator tooling stays local-only; the .ipynb files themselves
# are the tracked artifact. Glob (not the three literal filenames this used
# to list) so new build_*.py/validate*.py scripts are covered automatically,
# including the ones nested under notebooks/kaggle/<kernel>/.
notebooks/**/build_*.py
notebooks/**/validate*
notebooks/_notebook_common.py

# Next.js / Node (Vercel branch frontend)
# Next.js / Node build output -- not part of main, but these directories can
# end up sitting in the working tree regardless of branch (e.g. after
# switching from Vercel), so ignore them here too rather than let a git GUI
# list thousands of individual files.
/node_modules
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts
.vercel
